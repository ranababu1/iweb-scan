# Port is provided by Hostinger automatically; 3000 locally.
PORT=3000
# Public URL used in canonical/OG/badge links.
PUBLIC_BASE_URL=https://scan.iwebandseo.com
# Where cached reports and leads are written (must be writable).
DATA_DIR=./data
# Cache lifetime for scan results, in minutes.
CACHE_TTL_MINUTES=60
# Fresh scans allowed per IP.
RATE_PER_MINUTE=10
RATE_PER_DAY=50
# Number of proxy hops in front of the app (for the client IP used by rate limits).
TRUST_PROXY=1
# Max parallel scans and overall scan timeout.
MAX_CONCURRENT_SCANS=4
SCAN_TOTAL_TIMEOUT_MS=45000
# Optional: enables GET /admin/leads.csv?token=... to download fix-plan leads.
ADMIN_TOKEN=
# Local dev only: allow sandbox fake-IP DNS (198.18.0.0/15). Never set in production.
# SCAN_ALLOW_FAKE_IP=1
